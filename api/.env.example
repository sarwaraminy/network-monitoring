# --- Server ---
PORT=8080
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# trace | debug | info | warn | error | fatal | silent
# Defaults to info, or silent under the test runner.
LOG_LEVEL=info

# --- PostgreSQL ---
# Either supply a full URL...
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/netminitoring
# ...or the individual parts (used only when DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=netminitoring
# PGUSER=postgres
# PGPASSWORD=CHANGE_ME

# Run pending SQL migrations automatically on boot.
DB_AUTO_MIGRATE=true

# --- Auth ---
# REQUIRED. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Rate limits (requests per minute, per client IP) ---
# Failed logins only; successful sign-ins are not counted.
RATE_LIMIT_AUTH_PER_MINUTE=20
# Starting, stopping and clearing captures.
RATE_LIMIT_CAPTURE_PER_MINUTE=20
# ip-info, which fans out to reverse DNS, WHOIS and a third-party API.
RATE_LIMIT_LOOKUP_PER_MINUTE=30
# Backstop for everything else under /api.
RATE_LIMIT_API_PER_MINUTE=600

# --- Packet capture ---
# Highest number of decoded packets kept in memory per capture session.
CAPTURE_BUFFER_SIZE=5000
# How often a running capture is drained, in milliseconds. The pcap handle is
# non-blocking, so this is a poll interval rather than a timeout.
CAPTURE_POLL_INTERVAL_MS=10
# Blanks packet payloads in API responses. Consider enabling this where captured
# traffic may contain personal data or message content.
REDACT_PACKET_PAYLOAD=false
# IP -> MAC pairs treated as authoritative for ARP spoof detection.
ARP_TRUSTED_MAPPINGS=10.0.0.1=00:11:22:33:44:55,10.0.0.2=66:77:88:99:aa:bb

# --- Detection thresholds ---
# Each trades false positives against missed detections; tune per network.
DETECT_SCAN_WINDOW_MS=60000
DETECT_PORT_SCAN_PORTS=15
DETECT_HOST_SWEEP_HOSTS=20
DETECT_FLOOD_WINDOW_MS=10000
DETECT_SYN_FLOOD_ATTEMPTS=300
DETECT_DNS_SUBDOMAINS=40
DETECT_DEVICE_LEARNING_MS=60000
DETECT_ALERT_WINDOW_MS=300000
