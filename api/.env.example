# --- Server ---
PORT=8080
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# trace | debug | info | warn | error | fatal | silent
# Defaults to info, or silent under the test runner.
LOG_LEVEL=info

# --- PostgreSQL ---
# Either supply a full URL...
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/netminitoring
# ...or the individual parts (used only when DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=netminitoring
# PGUSER=postgres
# PGPASSWORD=CHANGE_ME

# Run pending SQL migrations automatically on boot.
DB_AUTO_MIGRATE=true

# --- Auth ---
# REQUIRED. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Allow anyone to register an account.
#
# Leave false. Accounts are created by an administrator, plus a single
# unauthenticated request to create the very first account on an empty
# installation. Even with this true, a self-registered account is always a USER —
# a public form that can mint administrators is the hole this replaced.
ALLOW_OPEN_SIGNUP=false

# --- Rate limits (requests per minute, per client IP) ---
# Failed logins only; successful sign-ins are not counted.
RATE_LIMIT_AUTH_PER_MINUTE=20
# Starting, stopping and clearing captures.
RATE_LIMIT_CAPTURE_PER_MINUTE=20
# ip-info, which fans out to reverse DNS, WHOIS and a third-party API.
RATE_LIMIT_LOOKUP_PER_MINUTE=30
# Backstop for everything else under /api.
RATE_LIMIT_API_PER_MINUTE=600

# --- Packet capture ---
# Highest number of decoded packets kept in memory per capture session.
CAPTURE_BUFFER_SIZE=5000
# How often a running capture is drained, in milliseconds. The pcap handle is
# non-blocking, so this is a poll interval rather than a timeout.
CAPTURE_POLL_INTERVAL_MS=10
# Blanks packet payloads in API responses. Consider enabling this where captured
# traffic may contain personal data or message content.
REDACT_PACKET_PAYLOAD=false
# IP -> MAC pairs treated as authoritative for ARP spoof detection.
ARP_TRUSTED_MAPPINGS=10.0.0.1=00:11:22:33:44:55,10.0.0.2=66:77:88:99:aa:bb

# --- Alert notifications ---
# Without these, a critical finding is written to a table and nobody is told.
# Off by default: upgrading should not start emailing people.
NOTIFY_ENABLED=false

# Notify at this severity and above: critical | high | medium | low | info.
# Leave at `high`. Medium and below belong on the dashboard — putting them in an
# inbox is how the channel gets muted, and then the critical one is missed too.
NOTIFY_MIN_SEVERITY=high

# Findings are batched for this long so one burst becomes one message. A port
# scan produces dozens of findings; forty separate emails about one event is how
# a recipient learns to ignore you.
NOTIFY_DIGEST_SECONDS=60
# The same finding will not notify again inside this period, however often it recurs.
NOTIFY_THROTTLE_SECONDS=900
# Hard ceiling per hour, whatever detection does. A backstop, not a tuning knob.
NOTIFY_MAX_PER_HOUR=12

# Include structured evidence in the message.
#
# Evidence never contains passwords or packet payloads — the detectors guarantee
# it and the tests assert it, including the base64 form. It does contain internal
# IP addresses, MAC addresses and usernames, and sending those to a third-party
# chat service moves them outside the network you are protecting. Set false if
# that matters to you; the alert titles still say what happened.
NOTIFY_INCLUDE_EVIDENCE=true

# Linked from every message, so the recipient can get to the detail in one click.
NOTIFY_DASHBOARD_URL=http://localhost:8080/alerts

# --- Notifications: webhook (Slack, Teams, Discord, or anything taking JSON) ---
# The quickest channel to set up — no mail server involved. The payload shape is
# inferred from the URL; override with NOTIFY_WEBHOOK_FORMAT if needed.
# Treat this URL as a secret: it is a bearer credential for Slack and Teams.
NOTIFY_WEBHOOK_URL=
# auto | slack | teams | discord | generic
NOTIFY_WEBHOOK_FORMAT=auto

# --- Notifications: email over SMTP ---
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Network Monitoring <nmt@example.com>
SMTP_HOST=
SMTP_PORT=587
# True only for implicit TLS on port 465. On 587 leave this false — STARTTLS is
# negotiated instead, and setting it true there hangs until the socket times out.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Flow collection (NetFlow v5/v9, IPFIX) ---
# Receives flow summaries exported by a switch, router or firewall. No driver, no
# elevated privileges and no SPAN port needed, and it sees every conversation
# crossing the exporter rather than only this host's own traffic.
#
# Off by default: a listening UDP port is not something a deployment should
# acquire just by upgrading.
FLOW_ENABLED=false
# 2055 is the de facto NetFlow port; 4739 is IANA's for IPFIX.
FLOW_PORT=2055
# Narrow this to a management interface in production. NetFlow has no
# authentication, so reachability is the access control.
FLOW_BIND_ADDRESS=0.0.0.0
# Comma-separated addresses permitted to send flow data. Empty accepts any
# source, which is needed to discover an exporter's address on a first run — fill
# it in once the devices are known. Source addresses are spoofable, so this is
# the only filter the protocol permits.
FLOW_EXPORTERS=

# --- Detection thresholds ---
# Shared by the packet and flow detectors.
# Each trades false positives against missed detections; tune per network.
DETECT_SCAN_WINDOW_MS=60000
DETECT_PORT_SCAN_PORTS=15
DETECT_HOST_SWEEP_HOSTS=20
DETECT_FLOOD_WINDOW_MS=10000
DETECT_SYN_FLOOD_ATTEMPTS=300
DETECT_DNS_SUBDOMAINS=40
DETECT_DEVICE_LEARNING_MS=60000
DETECT_ALERT_WINDOW_MS=300000
