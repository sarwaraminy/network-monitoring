# --- Server ---
PORT=8080
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# trace | debug | info | warn | error | fatal | silent
# Defaults to info, or silent under the test runner.
LOG_LEVEL=info

# --- PostgreSQL ---
# Either supply a full URL...
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/netminitoring
# ...or the individual parts (used only when DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=netminitoring
# PGUSER=postgres
# PGPASSWORD=CHANGE_ME

# Run pending SQL migrations automatically on boot.
DB_AUTO_MIGRATE=true

# --- Auth ---
# REQUIRED. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Allow anyone to register an account.
#
# Leave false. Accounts are created by an administrator, plus a single
# unauthenticated request to create the very first account on an empty
# installation. Even with this true, a self-registered account is always a USER —
# a public form that can mint administrators is the hole this replaced.
ALLOW_OPEN_SIGNUP=false

# --- Rate limits (requests per minute, per client IP) ---
# Failed logins only; successful sign-ins are not counted.
RATE_LIMIT_AUTH_PER_MINUTE=20
# Starting, stopping and clearing captures.
RATE_LIMIT_CAPTURE_PER_MINUTE=20
# ip-info, which fans out to reverse DNS, WHOIS and a third-party API.
RATE_LIMIT_LOOKUP_PER_MINUTE=30
# Backstop for everything else under /api.
RATE_LIMIT_API_PER_MINUTE=600

# --- Packet capture ---
# Highest number of decoded packets kept in memory per capture session.
CAPTURE_BUFFER_SIZE=5000
# How often a running capture is drained, in milliseconds. The pcap handle is
# non-blocking, so this is a poll interval rather than a timeout.
CAPTURE_POLL_INTERVAL_MS=10
# Blanks packet payloads in API responses. Consider enabling this where captured
# traffic may contain personal data or message content.
# Read the client IP from X-Forwarded-For. Leave OFF for a direct host install:
# with nothing setting the header, a caller can send a fresh value per request
# and never trip the auth rate limiter. Compose turns it on, because nginx is
# always in front there.
TRUST_PROXY=false
REDACT_PACKET_PAYLOAD=true
# IP -> MAC pairs treated as authoritative for ARP spoof detection.
ARP_TRUSTED_MAPPINGS=10.0.0.1=00:11:22:33:44:55,10.0.0.2=66:77:88:99:aa:bb

# --- Alert notifications ---
# Without these, a critical finding is written to a table and nobody is told.
# Off by default: upgrading should not start emailing people.
NOTIFY_ENABLED=false

# Notify at this severity and above: critical | high | medium | low | info.
# Leave at `high`. Medium and below belong on the dashboard — putting them in an
# inbox is how the channel gets muted, and then the critical one is missed too.
NOTIFY_MIN_SEVERITY=high

# Findings are batched for this long so one burst becomes one message. A port
# scan produces dozens of findings; forty separate emails about one event is how
# a recipient learns to ignore you.
NOTIFY_DIGEST_SECONDS=60
# The same finding will not notify again inside this period, however often it recurs.
NOTIFY_THROTTLE_SECONDS=900
# Hard ceiling per hour, whatever detection does. A backstop, not a tuning knob.
NOTIFY_MAX_PER_HOUR=12

# Include structured evidence in the message.
#
# Evidence never contains passwords or packet payloads — the detectors guarantee
# it and the tests assert it, including the base64 form. It does contain internal
# IP addresses, MAC addresses and usernames, and sending those to a third-party
# chat service moves them outside the network you are protecting. Set false if
# that matters to you; the alert titles still say what happened.
NOTIFY_INCLUDE_EVIDENCE=true

# Linked from every message, so the recipient can get to the detail in one click.
NOTIFY_DASHBOARD_URL=http://localhost:8080/alerts

# ============================================================================
# Everything from here to the end of the syslog block can now also be set on the
# Delivery page in the UI, and stored in the database instead of this file.
#
# A variable set HERE WINS over anything set in the UI, and the page shows such a
# field as locked with the variable's name. That is deliberate: a deployment driven
# by Compose or config management should keep its configuration pinned in a file
# that a web form cannot contradict. Leave a variable out (or blank, which counts
# as unset) to manage the setting from the page instead.
#
# On first boot, whatever these variables currently say is copied into the database,
# so removing a line later keeps the behaviour you had rather than reverting to a
# default.
# ============================================================================

# --- Notifications: webhook (Slack, Teams, Discord, or anything taking JSON) ---
# The quickest channel to set up — no mail server involved. The payload shape is
# inferred from the URL; override with NOTIFY_WEBHOOK_FORMAT if needed.
# Treat this URL as a secret: it is a bearer credential for Slack and Teams.
#
# For Teams, create a **Workflows** webhook (Teams > channel > Workflows > "Post to
# a channel when a webhook request is received"). Its URL is on *.logic.azure.com
# and is detected automatically. Office 365 connectors — the *.webhook.office.com
# URLs — are retired by Microsoft; see teams-connector below.
NOTIFY_WEBHOOK_URL=
# auto | slack | teams | discord | generic | teams-connector
#
# `teams` renders an Adaptive Card, which is what a Workflows webhook expects.
# `teams-connector` renders the retired Office 365 MessageCard, and exists only for
# an installation whose connector webhook is still provisioned. It is never inferred
# from a URL: choosing a retired format has to be deliberate.
NOTIFY_WEBHOOK_FORMAT=auto

# --- Export: syslog / CEF to a SIEM ---
#
# Deliberately NOT subject to NOTIFY_MIN_SEVERITY, the digest or the throttle.
# Those exist so a person does not mute a noisy inbox; a SIEM correlates and
# deduplicates itself and needs the complete stream, so it receives every
# finding. It is also independent of NOTIFY_ENABLED — feeding a collector you
# already own is a different decision from putting alerts in someone's inbox.
#
# Set the host to switch it on.
SYSLOG_HOST=
SYSLOG_PORT=514
# udp | tcp. UDP is fire-and-forget, which is what syslog has always been; use
# TCP where delivery matters.
SYSLOG_PROTOCOL=udp
# cef | json. CEF is what Splunk, QRadar, Sentinel and Graylog connector guides
# assume when they say "send us syslog".
SYSLOG_FORMAT=cef
# 5424 | 3164. 3164 has no year and no timezone in its timestamp; prefer 5424.
SYSLOG_RFC=5424
# 16-23 are the local-use facilities; 16 is local0.
SYSLOG_FACILITY=16
SYSLOG_APP_NAME=nmt
# On by default, unlike the chat channels: the disclosure argument that gates
# evidence for Slack does not apply to a collector inside your own network.
SYSLOG_INCLUDE_EVIDENCE=true

# --- Notifications: email over SMTP ---
#
# Which host to point this at, in the order that actually works:
#
#  1. An INTERNAL RELAY. Most organisations running a monitoring tool already have
#     one, it needs no credentials, and it is the right answer for an on-prem
#     sensor. Set SMTP_HOST and leave SMTP_USER and SMTP_PASSWORD empty — the
#     transport then omits AUTH entirely.
#  2. An APP PASSWORD, where the tenant still permits one.
#  3. OAUTH2 (XOAUTH2), for a tenant that permits nothing else. See below.
#  4. Your company mailbox with a normal username and password — this usually does
#     NOT work. Microsoft 365 and Google disable basic SMTP AUTH by default on
#     modern tenants, and the rejection is indistinguishable from a wrong password.
#     The Delivery page names that cause when it sees a 535 or EAUTH.
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Network Monitoring <nmt@example.com>
SMTP_HOST=
SMTP_PORT=587
# True only for implicit TLS on port 465. On 587 leave this false — STARTTLS is
# negotiated instead, and setting it true there hangs until the socket times out.
SMTP_SECURE=false
# `password` (AUTH LOGIN/PLAIN, or no AUTH at all when SMTP_USER is empty) or
# `oauth2` (XOAUTH2 with a refresh token).
#
# Left BLANK on purpose: password is the default already, and pinning it to `password`
# is what makes this feature unreachable from the Delivery page — the select renders
# disabled and the OAuth2 fields are hidden with it, since the form shows each
# method's fields and only its own.
#
# Pinning `oauth2` is different, and is a supported configuration: the select is
# disabled but all five credential fields stay editable, so the method is fixed in
# this file while the credentials can still be rotated from the UI.
SMTP_AUTH_METHOD=
# Both empty for an internal relay: the transport then sends no AUTH at all.
# Under oauth2 SMTP_USER is the mailbox being sent from and is required.
SMTP_USER=
SMTP_PASSWORD=

# --- Notifications: email over OAuth2 (only read when SMTP_AUTH_METHOD=oauth2) ---
#
# The refresh-token grant, and nothing more ambitious: register an application with
# your identity provider, consent to it once as the sending mailbox, and paste the
# refresh token it returns here. The access token is minted from it on first use and
# renewed on expiry — nothing here stores or schedules one. There is no
# authorization-code redirect, because that needs a browser round trip through a
# public callback URL and this runs on a sensor inside your network.
#
# Microsoft 365. Register an app in Entra ID and add the API permission
# "Office 365 Exchange Online -> Delegated -> SMTP.Send". SMTP AUTH must ALSO be
# enabled on the mailbox itself — OAuth2 does not bypass that per-mailbox setting,
# and this is the most common reason a correctly issued token is still refused:
#     Set-CASMailbox -Identity nmt@contoso.com -SmtpClientAuthenticationDisabled $false
#   SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
#   SMTP_OAUTH_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
#   SMTP_OAUTH_SCOPE=https://outlook.office.com/SMTP.Send offline_access
#
# Google Workspace. Create an OAuth client in Google Cloud, consent with the scope
# https://mail.google.com/, and use the refresh token from that consent:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
#   SMTP_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
#   SMTP_OAUTH_SCOPE=  (Google's refresh grant ignores it)
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
# No default on purpose. Nodemailer's own fallback is Google's endpoint, so a blank
# value on a Microsoft tenant would post the refresh token to accounts.google.com.
SMTP_OAUTH_TOKEN_URL=
SMTP_OAUTH_SCOPE=

# --- Retention ---
#
# `alerts` and `known_devices` grow for ever otherwise: one recurring finding writes a
# row every DETECT_ALERT_WINDOW_MS, and known_devices gains a row per MAC address ever
# seen — on a network of phones using randomised addresses, one per phone per address.
#
# Detail expires; the shape does not. Every expired day of alerts is aggregated into
# alert_rollup_daily in the same transaction that deletes it, and rollups are never
# pruned — so a dashboard set to a year still has a trend long after the rows have
# gone. Deleting without that would make an expired month look exactly like a quiet one.
RETENTION_ENABLED=true
# Full-detail alert rows. Under 7 days is clamped up to 7 with a warning: a slipped
# digit here deletes findings that cannot be recovered.
ALERT_RETENTION_DAYS=365
# How long a device is remembered after it was last seen — refreshed while it keeps
# appearing on the network, so this is absence and not age. Forgetting a device means
# it is reported as new if it ever comes back.
DEVICE_RETENTION_DAYS=365
# Gap between sweeps, 1-596 hours. The ceiling is not a policy choice: past it a
# JavaScript timer silently becomes 1 ms and the sweep runs continuously.
RETENTION_SWEEP_HOURS=24

# --- Threat intelligence ---
# The one detector here that is not a heuristic. Everything else measures
# behaviour against a threshold; this checks whether an address or domain is on a
# list of things already known to be malicious. A hit is actionable without
# tuning, which no threshold finding can claim.
#
# Off by default, and no feeds are shipped: which intelligence to trust is your
# decision, and a security tool should not start making outbound requests to a
# third-party list nobody chose.
INTEL_ENABLED=false

# Comma-separated `name=location`. A location is a URL or a file path, and local
# files are first-class — the networks this tool targets frequently have no
# outbound internet from the monitoring host. Downloaded feeds are cached, so a
# restart without connectivity still starts with the last known-good copy.
#
# Widely used free feeds, in the formats this parser reads. Check each one's
# licence and terms before relying on it in a commercial deployment:
#   feodo=https://feodotracker.abuse.ch/downloads/ipblocklist.txt
#   sslbl=https://sslbl.abuse.ch/blacklist/sslipblacklist.txt
#   drop=https://www.spamhaus.org/drop/drop.txt
# Or point at a file you curate yourself:
#   internal=/etc/nmt/indicators.txt
INTEL_FEEDS=

# How often feeds are re-read. Stale intelligence is close to useless.
INTEL_REFRESH_HOURS=6
# Where downloaded copies are kept. Defaults to api/.cache/intel.
INTEL_CACHE_DIR=
# Ceiling on indicators held in memory, so one runaway feed cannot exhaust it.
INTEL_MAX_INDICATORS=500000

# --- Flow collection (NetFlow v5/v9, IPFIX) ---
# Receives flow summaries exported by a switch, router or firewall. No driver, no
# elevated privileges and no SPAN port needed, and it sees every conversation
# crossing the exporter rather than only this host's own traffic.
#
# Off by default: a listening UDP port is not something a deployment should
# acquire just by upgrading.
FLOW_ENABLED=false
# 2055 is the de facto NetFlow port; 4739 is IANA's for IPFIX.
FLOW_PORT=2055
# Narrow this to a management interface in production. NetFlow has no
# authentication, so reachability is the access control.
FLOW_BIND_ADDRESS=0.0.0.0
# Comma-separated addresses permitted to send flow data. Empty accepts any
# source, which is needed to discover an exporter's address on a first run — fill
# it in once the devices are known. Source addresses are spoofable, so this is
# the only filter the protocol permits.
FLOW_EXPORTERS=

# --- Detection thresholds ---
# Shared by the packet and flow detectors.
# Each trades false positives against missed detections; tune per network.
DETECT_SCAN_WINDOW_MS=60000
DETECT_PORT_SCAN_PORTS=15
DETECT_HOST_SWEEP_HOSTS=20
DETECT_FLOOD_WINDOW_MS=10000
DETECT_SYN_FLOOD_ATTEMPTS=300
DETECT_DNS_SUBDOMAINS=40
DETECT_DEVICE_LEARNING_MS=60000
DETECT_ALERT_WINDOW_MS=300000

# --- Ad Hoc Query console ---
# A read-only SQL page for administrators, for the question no screen answers.
#
# OFF by default, and that default is deliberate: switched on without thought
# this is a SQL prompt on the production database reachable from a browser
# session. An installation should have to decide to have it.
#
# There is no connection string here on purpose. The console's Postgres role is
# fixed in code (`nm_adhoc`, created by V10 with SELECT-only grants and the
# columns holding secrets excluded), and only its password comes from here — a
# settable URL would be one an operator could point at the superuser, turning
# every restriction off while the feature still appeared to work. The server
# additionally refuses to enable the console unless the database confirms that
# role is neither a superuser nor able to write.
#
# All of these can also be changed by an administrator in the interface, under
# the settings gear — the console can be switched on, given a password and have
# its limits tuned without a restart, which on a monitoring server means without
# dropping a live capture. The environment still wins: a variable set here PINS
# its field, and the interface disables the control and names the variable rather
# than accepting an edit that changes nothing. Left commented for that reason;
# the code default for ADHOC_ENABLED is false either way.
# ADHOC_ENABLED=false
# Required when enabled. Installed on the nm_adhoc role at boot with ALTER ROLE,
# a statement with no parameterised form — so the value is part of the statement
# text and Postgres's own log may record it under log_statement='ddl' or 'all'.
#
# Settable in the interface as well (V15), and setting it HERE pins it there. The
# earlier design kept it environment-only on the argument that it was what kept
# the decision to *have* a SQL prompt on production with whoever installed the
# server; that trade was made deliberately so an administrator can provision the
# console without server access. If you want the old behaviour, set this line:
# the field then renders disabled and the API refuses a change to it.
#
# Never returned by the API and never written to the audit trail, wherever it came
# from. Any strong value, not reused anywhere.
# NOTE: removing this line later does NOT switch the console off. Whatever it
# said was copied into the stored settings at first boot, so the row keeps the
# copy. Set ADHOC_ENABLED=false, or switch it off in the interface.
# ADHOC_DB_PASSWORD=
# ADHOC_TIMEOUT_MS=10000
# ADHOC_MAX_ROWS=1000
# Lets the console UPDATE, INSERT and DELETE as well as read. OFF by default,
# and separate from ADHOC_ENABLED on purpose: switching the console on and
# letting it write are two decisions, and only one can destroy data from a
# browser session.
#
# It selects a different Postgres ROLE rather than merely permitting writes in
# the app, so a read-only install is read-only in the database rather than in an
# `if`. Write mode still cannot touch the audit trail, the accounts, the delivery
# settings or the columns holding secrets, and is still not a superuser: it
# writes the operational tables only. See V12__Adhoc_write_role.sql.
#
# Auditing is forced to `all` while this is on.
# ADHOC_WRITE_ENABLED=false
# ADHOC_MAX_QUERY_LENGTH=20000
# How much of the console's activity reaches the audit trail:
#   all     - every query as it is accepted (the default; "who asked what" is
#             what an audit trail is for, and this is a SQL console over
#             security findings)
#   refused - only queries the database rejected, which is the set worth keeping
#             if you are reading the trail for attempts rather than activity
#   off     - nothing
# ADHOC_AUDIT=all
