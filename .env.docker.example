# Copy to .env in the repository root, then `docker compose up --build`.
# This file configures the containers only; api/.env is for running on the host.

# --- Required ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
POSTGRES_PASSWORD=

# --- Optional ---
POSTGRES_DB=netminitoring
POSTGRES_USER=postgres

# Port the UI (and the proxied API) is published on.
HTTP_PORT=8080

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

JWT_EXPIRES_IN=1d

# Public registration. Leave false; self-registered accounts are always USER.
ALLOW_OPEN_SIGNUP=false

# Threat intelligence. See api/.env.example for feed examples.
INTEL_ENABLED=false
INTEL_FEEDS=
INTEL_REFRESH_HOURS=6
INTEL_MAX_INDICATORS=500000
# The cache path inside the container is fixed by docker-compose.yml and backed
# by the `intel-cache` volume, so it is not set here.
CORS_ORIGIN=http://localhost:8080

# Blanks packet payloads in API responses. Consider enabling where captured
# traffic may contain personal data.
REDACT_PACKET_PAYLOAD=true

CAPTURE_BUFFER_SIZE=5000
ARP_TRUSTED_MAPPINGS=
VITE_POLL_INTERVAL_MS=1000

# --- Alert notifications ---
# Without this, a critical finding lands in a table and nobody is told.
NOTIFY_ENABLED=false
# critical | high | medium | low | info. Leave at high.
NOTIFY_MIN_SEVERITY=high
# Slack, Teams, Discord, or anything accepting JSON. Treat as a secret.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=auto
# Set false to keep internal IPs, MACs and usernames out of third-party chat.
NOTIFY_INCLUDE_EVIDENCE=true
NOTIFY_DIGEST_SECONDS=60
NOTIFY_THROTTLE_SECONDS=900
NOTIFY_MAX_PER_HOUR=12
# Email, if you have an SMTP relay.
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Flow collection ---
# Only used with the flow override:
#   docker compose -f docker-compose.yml -f docker-compose.flow.yml up --build
# 2055 is the de facto NetFlow port; 4739 is IANA's for IPFIX.
FLOW_PORT=2055
# Comma-separated exporter addresses. Empty accepts any source, which is needed
# to discover them on a first run; set it once the devices are known.
FLOW_EXPORTERS=

# --- Export: syslog / CEF to a SIEM ---
# Set the host to switch it on. Not governed by NOTIFY_ENABLED or the gates
# above — a SIEM needs the complete stream, not a digest.
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp
SYSLOG_FORMAT=cef
SYSLOG_RFC=5424
SYSLOG_FACILITY=16
SYSLOG_APP_NAME=nmt
SYSLOG_INCLUDE_EVIDENCE=true

# --- Behind a proxy ---
# On here, because the api is expose-only and every request arrives through the
# nginx ui service, which sets X-Forwarded-For. Off, the rate limiter keys every
# client to the nginx container and they share one bucket.
TRUST_PROXY=true

# Linked from notification messages.
NOTIFY_DASHBOARD_URL=

# --- Flow collection ---
# The driver-free path: point a switch or router at FLOW_PORT and no capture
# library is needed. Publishing the UDP port is a separate opt-in — see
# docker-compose.flow.yml.
FLOW_ENABLED=false
FLOW_BIND_ADDRESS=0.0.0.0

# --- Capture tuning ---
CAPTURE_POLL_INTERVAL_MS=10

# --- Rate limits ---
# The right values depend on how many people share an egress address.
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CAPTURE_PER_MINUTE=20
RATE_LIMIT_LOOKUP_PER_MINUTE=30
RATE_LIMIT_API_PER_MINUTE=600

# --- Detector thresholds ---
# The tuning knobs. An authorised vulnerability scanner on the network is the
# usual reason to raise one — it will otherwise trip the port-scan and host-sweep
# detectors on every scan cycle.
DETECT_SCAN_WINDOW_MS=60000
DETECT_PORT_SCAN_PORTS=15
DETECT_HOST_SWEEP_HOSTS=20
DETECT_FLOOD_WINDOW_MS=10000
DETECT_SYN_FLOOD_ATTEMPTS=300
DETECT_DNS_SUBDOMAINS=40
DETECT_DEVICE_LEARNING_MS=60000
DETECT_ALERT_WINDOW_MS=300000

# --- Retention ---
# Alerts expire in detail after ALERT_RETENTION_DAYS and survive as daily rollups,
# which are never pruned, so a long dashboard window keeps its shape. Set
# RETENTION_ENABLED=false to keep everything. Under 7 days is clamped up with a
# warning: a slipped digit deletes findings irreversibly.
RETENTION_ENABLED=true
ALERT_RETENTION_DAYS=365
# Days of absence, not age: `last_seen` is refreshed while a device keeps appearing.
# Forgetting a device means it is reported as new if it comes back.
DEVICE_RETENTION_DAYS=365
# Gap between sweeps, 1-596 hours (past that a JavaScript timer inverts into 1 ms).
RETENTION_SWEEP_HOURS=24
